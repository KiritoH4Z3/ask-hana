# Copy to .env and edit. Every value below is a safe default or an empty placeholder.

# auto | claude | ollama | extractive
# auto: Claude if ANTHROPIC_API_KEY is set, else Ollama if OLLAMA_MODEL is installed, else extractive.
ASK_HANA_PROVIDER=auto

# Claude (optional)
ANTHROPIC_API_KEY=
ASK_HANA_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (the ASK_HANA_ prefix keeps Claude Code's own CLAUDE_EFFORT out)
ASK_HANA_CLAUDE_EFFORT=low

# Ollama (optional). Auto mode only considers Ollama when OLLAMA_MODEL is set.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Data
KNOWLEDGE_DIR=./knowledge
CHROMA_PATH=./data/chroma

# Retrieval: TOP_K is 1 to 8; MIN_SCORE is the cosine similarity a passage needs to count (0 to 1)
TOP_K=4
MIN_SCORE=0.33

# Limits
RATE_LIMIT_PER_MINUTE=12
PROVIDER_TIMEOUT_S=60

# Server
HOST=127.0.0.1
PORT=3012
